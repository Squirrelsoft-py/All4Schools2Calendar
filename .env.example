# School portal (All4Schools)
A4S_URL=schule.louisenlund.de
A4S_USERNAME=example-user
A4S_PASSWORD=example-password
A4S_PIN=

# CalDAV calendar
CALDAV_URL=https://caldav.example.com/calendars/EXAMPLE0000/00000000-0000-0000-0000-000000000000
CALDAV_USERNAME=example-user
CALDAV_PASSWORD=example-password
CALDAV_CALENDAR_NAME=Stundenplan

# Timetable
# Subjects that are removed from the calendar, comma separated.
# The filter is compared without spaces and case, so "StudioTimes" also matches
# "Studio Times digitalfrei".
A4S_FILTERS=StudioTimes
# Number of days that are synced
A4S_SYNC_DAYS=31

# Scheduler: hours between two syncs
SYNC_INTERVAL_HOURS=24
